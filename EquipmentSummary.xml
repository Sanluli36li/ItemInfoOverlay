<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">
    <Script file="EquipmentSummary.lua"/>

    <Frame name="IIOEquipmentSummaryEntryStatIconTemplate" virtual="true">
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" file="Interface\AddOns\ItemInfoOverlay\Media\icon\stats_Armory\crit.png" alphaMode="BLEND">
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent" relativePoint="LEFT" x="0"/>
                        <Anchor point="RIGHT" relativeKey="$parent" relativePoint="RIGHT" x="0"/>
                        <Anchor point="TOP" relativeKey="$parent" relativePoint="TOP" y="0"/>
                        <Anchor point="BOTTOM" relativeKey="$parent" relativePoint="BOTTOM" y="0"/>
                    </Anchors>
                </Texture>
                <FontString parentKey="Text" inherits="GameTooltipText" justifyH="CENTER" justifyV="CENTER">
                    <Size x="24"/>
                    <Anchors>
                        <Anchor point="CENTER" relativeKey="$parent" relativePoint="CENTER" x="0" y="0"/>
                    </Anchors>
                </FontString>
                <Texture parentKey="Backdrop" file="Interface\AddOns\ItemInfoOverlay\Media\icon\edge.png" alphaMode="BLEND">
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent" relativePoint="LEFT" x="0"/>
                        <Anchor point="RIGHT" relativeKey="$parent" relativePoint="RIGHT" x="0"/>
                        <Anchor point="TOP" relativeKey="$parent" relativePoint="TOP" y="0"/>
                        <Anchor point="BOTTOM" relativeKey="$parent" relativePoint="BOTTOM" y="0"/>
                    </Anchors>
                </Texture>
            </Layer>
        </Layers>
    </Frame>

    <Frame name="IIOEquipmentSummaryEntryTemplate" mixin="IIOEquipmentSummaryEntryMixin" virtual="true">
        <Size y="14"/>
        <Layers>
            <Layer level="ARTWORK">
                <FontString parentKey="SlotName" inherits="GameTooltipText">
                    <Size x="40"/>
                    <Anchors>
                        <Anchor point="LEFT"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="ItemLevel" inherits="GameTooltipText">
                    <Size x="24"/>
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.VersatilityIcon" relativePoint="RIGHT" x="2"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="ItemLink" inherits="GameTooltipText" wordwrap="false" nonspacewrap="false">
                    <Size x="150"/>
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.ItemLevel" relativePoint="RIGHT" x="2"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="ItemUpgrade" inherits="GameTooltipText" wordwrap="false" nonspacewrap="false">
                    <Size x="100"/>
                    <Anchors>
                        <Anchor point="LEFT" relativeKey="$parent.ItemLink" relativePoint="RIGHT" x="2"/>
                    </Anchors>
                </FontString>
			</Layer>
        </Layers>
        <Frames>
            <Frame parentKey="CritIcon" inherits="IIOEquipmentSummaryEntryStatIconTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent" relativePoint="RIGHT" x="1" y="-1"/>
                </Anchors>
            </Frame>
            <Frame parentKey="HasteIcon" inherits="IIOEquipmentSummaryEntryStatIconTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.CritIcon" relativePoint="RIGHT" x="1"/>
                </Anchors>
            </Frame>
            <Frame parentKey="MasteryIcon" inherits="IIOEquipmentSummaryEntryStatIconTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.HasteIcon" relativePoint="RIGHT" x="1"/>
                </Anchors>
            </Frame>
            <Frame parentKey="VersatilityIcon" inherits="IIOEquipmentSummaryEntryStatIconTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.MasteryIcon" relativePoint="RIGHT" x="1"/>
                </Anchors>
            </Frame>
            <Frame parentKey="SlotNameBackdrop" inherits="BackdropTemplate">
                <Anchors>
                    <Anchor point="LEFT" relativeKey="$parent.SlotName" relativePoint="LEFT" x="0"/>
                    <Anchor point="RIGHT" relativeKey="$parent.SlotName" relativePoint="RIGHT" x="0"/>
                    <Anchor point="TOP" relativeKey="$parent.SlotName" relativePoint="TOP" y="0"/>
                    <Anchor point="BOTTOM" relativeKey="$parent.SlotName" relativePoint="BOTTOM" y="0"/>
                </Anchors>
            </Frame>
        </Frames>
        <Scripts>
            <OnLoad method="OnLoad"/>
            <OnEnter method="OnEnter"/>
            <OnLeave method="OnLeave"/>
        </Scripts>
    </Frame>

    <Frame name="IIOEquipmentSummaryFrameTemplate" mixin="IIOEquipmentSummaryFrameMixin" frameStrata="MEDIUM" hidden="true"  parent="UIParent" virtual="true" inherits="BackdropTemplate">
        <Size x="256"/>
        <Layers>
            <Layer level="BORDER">
                <FontString parentKey="Title" inherits="GameTooltipHeaderText" height="20">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="12" y="-12"/>
                        <Anchor point="TOPRIGHT" x="-12" y="-12"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="SubTitle" inherits="GameTooltipText">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Title" relativePoint="BOTTOMLEFT" x="0" y="-10"/>
                        <Anchor point="TOPRIGHT" relativeKey="$parent.Title" relativePoint="BOTTOMRIGHT" x="0" y="-10"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="InfoText" inherits="GameTooltipText">
                </FontString>
                <FontString parentKey="ItemStatsText1" inherits="GameTooltipText">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.InfoText" relativePoint="BOTTOMLEFT" x="0" y="0"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="ItemStatsText2" inherits="GameTooltipText">
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.ItemStatsText1" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
                    </Anchors>
                </FontString>
                <FontString parentKey="ItemStatsText3" inherits="GameTooltipText">
                    <Anchors>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.ItemStatsText2" relativePoint="BOTTOMRIGHT" x="0" y="0"/>
                    </Anchors>
                </FontString>
                <Texture parentKey="SpecIcon" mask="Interface\Minimap\UI-Minimap-Background" alpha="0.6">
                    <Size x="40" y="40"/>
                    <Anchors>
                        <Anchor point="TOPRIGHT" x="-10" y="-10"/>
                    </Anchors>
                </Texture>
			</Layer>
        </Layers>
        <Frames>
            <Frame parentKey="ItemStatsTips">
                <Size x="24" y="24"/>
                <Layers>
                    <Layer level="BACKGROUND">
                        <Texture parentKey="I" file="Interface\common\help-i"/>
                    </Layer>
                </Layers>
                <Anchors>
                    <Anchor point="TOPRIGHT" relativeKey="$parent.InfoText" relativePoint="BOTTOMRIGHT" x="8" y="4"/>
                </Anchors>
            </Frame>
        </Frames>
        <Scripts>
			<OnLoad method="OnLoad"/>
            <OnShow method="OnShow"/>
		</Scripts>
    </Frame>

    <Frame name="IIOEquipmentSummaryPlayerFrame" inherits="IIOEquipmentSummaryFrameTemplate" hidden="true" />
    <Frame name="IIOEquipmentSummaryInspectFrame" inherits="IIOEquipmentSummaryFrameTemplate" hidden="true" />
</Ui>
